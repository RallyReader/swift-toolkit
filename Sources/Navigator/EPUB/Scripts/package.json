{
  "name": "readium-js",
  "description": "A set of scripts for the EPUB navigator",
  "author": "Readium Foundation",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "private": true,
  "scripts": {
    "bundle": "webpack",
    "checkbundle": "webpack && git diff --exit-code -- ../Assets/Static/scripts",
    "lint": "eslint src",
    "checkformat": "prettier --check '**/*.js'",
    "format": "prettier --list-different --write '**/*.js'",
    "test": "jest"
  },
  "browserslist": [
    "iOS 13"
  ],
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "babel-jest": "29.7.0",
    "babel-loader": "^8.4.1",
    "eslint": "^7.32.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "2.3.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@juggle/resize-observer": "^3.4.0",
    "approx-string-match": "^1.1.0",
    "css-selector-generator": "^3.9.2",
    "string.prototype.matchall": "^4.0.12"
  },
  "packageManager": "pnpm@8.15.1",
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "contentType": "application/xhtml+xml",
      "html": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><html xmlns=\"http://www.w3.org/1999/xhtml\"><head><title>chapter</title></head><body></body></html>"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ]
  }
}
